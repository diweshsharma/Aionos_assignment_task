# Airline Disruption Agent — environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Groq API (primary LLM)
GROQ_API_KEY=your_groq_api_key_here

# External cheap-inference fallback (OpenAI-compatible)
FALLBACK_API_KEY=your_fallback_api_key_here
FALLBACK_API_URL=https://api.cheaperinference.com/v1

# Static bearer token for /chat and /admin/* endpoints
AUTH_TOKEN=dev_secret_token_123

# SQLite DB path (relative to backend/ dir)
DATABASE_URL=sqlite:///./airline_agent.db

# Chroma persistence directory (relative to backend/ dir)
CHROMA_PATH=./chroma_db
